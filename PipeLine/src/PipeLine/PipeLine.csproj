<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<!-- MUST be Library for NuGet -->
		<OutputType>Library</OutputType>

		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Metadata -->
		<PackageId>RHFactory.PipeLine</PackageId>
		<Version>1.0.0</Version>
		<Authors>Md. Zawad Hossain Rifat</Authors>
		<Company>RH-Factory</Company>
		<Product>PipeLine</Product>

		<Description>
			A simple, bidirectional, overlap-safe Named Pipes messaging library for .NET.
			Provides PipeServer and PipeClient for full-duplex IPC communication
			with built-in message framing and concurrent write protection.
		</Description>

		<PackageTags>named-pipes;ipc;messaging;dotnet</PackageTags>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<RepositoryUrl>https://github.com/Rifat-H7/PipeLine</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- REQUIRED for pack -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

		<!-- Optional but recommended -->
		<PackageProjectUrl>https://github.com/Rifat-H7/PipeLine</PackageProjectUrl>

		<!-- README inside package -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<Copyright>Copyright © 2026 Md. Zawad Hossain Rifat</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<!-- README must be in project root -->
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>